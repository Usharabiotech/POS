# Copy to `.env`. NEVER commit the real .env.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Local dev: start Postgres with `docker compose up -d` (port 5434), then this works as-is.
# Production: use your host's managed DATABASE_URL (Railway/Neon/Supabase/VPS).
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/cafepos?schema=public"

# Auth — CHANGE in any real deployment. Generate with: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-000000000000000000000000
ACCESS_TOKEN_TTL=12h

# CORS — comma-separated web origins allowed to call the API (dev = Vite server).
CORS_ORIGINS=http://localhost:5173

# Store config
STORE_NAME=Fresh Fruit Cafe
TAX_RATE=0.05
CURRENCY=INR
# PIN to unlock the kiosk manager menu (exit fullscreen / leave kiosk).
KIOSK_PIN=1010

# Seed admin — first ADMIN login, created once on first seed.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_CASHIER_USERNAME=cashier
SEED_CASHIER_PASSWORD=cashier123

# Swiggy/Zomato webhook: the shared secret the platform sends in `x-channel-secret`.
# Generate with: openssl rand -hex 32. Blank disables the webhook (simulator still works).
CHANNEL_WEBHOOK_SECRET=

# Razorpay payment gateway (UPI / cards / QR) for POS + kiosk.
# Blank = MOCK mode (dev demo only; refused in production). Add your TEST keys from
# Razorpay Dashboard ▸ Settings ▸ API Keys to take real test payments, then live keys
# for production. NEVER commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Force mock even in production (not recommended): PAYMENTS_MOCK=true

# Single-container deploy: point at the built SPA so the API also serves the frontend.
# Leave unset in local dev (Vite serves the client).
# PUBLIC_DIR=/app/client/dist
